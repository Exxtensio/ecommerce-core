{
    "name": "exxtensio/ecommerce-core",
    "version": "1.0.0",
    "license": "MIT",
    "description": "Exxtensio eCommerce Core is a build for Laravel 11.x which includes all the necessary for your online store backend application.",
    "type": "library",
    "keywords": [
        "exxtensio",
        "exxtensio ecommerce",
        "ecommerce",
        "online store",
        "shopping cart",
        "checkout",
        "laravel ecommerce",
        "product catalog",
        "orders",
        "multi-currency",
        "product attributes",
        "digital products",
        "physical products",
        "laravel shopping cart",
        "laravel store",
        "laravel orders",
        "laravel"
    ],
    "homepage": "https://github.com/exxtensio/ecommerce-core",
    "support": {
        "issues": "https://github.com/exxtensio/ecommerce-core/issues",
        "source": "https://github.com/exxtensio/ecommerce-core"
    },
    "authors": [
        {
            "name": "Vladlen Beilik",
            "email": "vladlen.beilik@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Exxtensio\\EcommerceCore\\": "src/",
            "Exxtensio\\EcommerceCore\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Exxtensio\\EcommerceCore\\Providers\\EcommerceServiceProvider"
            ],
            "aliases": {
                "Ecommerce": "Exxtensio\\EcommerceCore"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.9",
        "doctrine/dbal": "^4.2",
        "laravel/sanctum": "^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
